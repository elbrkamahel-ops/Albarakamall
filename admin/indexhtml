</main>

<script>

function toggleSidebar(){

    document
        .getElementById("sidebar")
        .classList
        .toggle("open");

}

function openStore(){

    location.href="../index.html";

}

function notifications(){

    alert(
        "🔔 الإشعارات\n\n" +
        "8 طلبات جديدة\n" +
        "7 منتجات منخفضة المخزون"
    );

}

document
    .getElementById("date")
    .textContent =
    new Date().toLocaleDateString(
        "ar-EG",
        {
            weekday:"long",
            year:"numeric",
            month:"long",
            day:"numeric"
        }
    );

async function loadProductsCount(){

    try{

        const response =
            await fetch(
                "../products.json?v="+Date.now()
            );

        if(!response.ok)
            throw new Error();

        const data =
            await response.json();

        const products =
            Array.isArray(data.products)
                ? data.products
                : Array.isArray(data)
                    ? data
                    : [];

        document
            .getElementById("productsCount")
            .textContent =
            products.length.toLocaleString(
                "ar-EG"
            );

    }catch(error){

        document
            .getElementById("productsCount")
            .textContent="—";

    }

}

loadProductsCount();

</script>

