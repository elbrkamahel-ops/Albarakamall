<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<meta name="theme-color" content="#087f3f">
<title>مول البركة | لوحة التحكم PRO</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0
}

:root{
    --primary:#087f3f;
    --primary2:#0dbb5b;
    --dark:#10231a;
    --dark2:#172d23;
    --bg:#f4f7f5;
    --card:#fff;
    --text:#18231e;
    --muted:#7c8982;
    --border:#e5ebe7;
    --danger:#e53935;
    --warning:#f59e0b;
    --info:#2563eb;
    --success:#079447;
    --shadow:0 10px 35px rgba(16,35,26,.07)
}

body{
    font-family:Tahoma,Arial,sans-serif;
    background:var(--bg);
    color:var(--text);
    min-height:100vh
}

button,input,select{
    font-family:inherit
}

button{
    cursor:pointer
}

a{
    text-decoration:none
}

/* TOP */

.topbar{
    position:fixed;
    z-index:1000;
    top:0;
    right:0;
    left:0;
    height:74px;
    background:rgba(255,255,255,.96);
    backdrop-filter:blur(15px);
    border-bottom:1px solid var(--border);
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 22px
}

.brand{
    display:flex;
    align-items:center;
    gap:12px
}

.logo{
    width:46px;
    height:46px;
    border-radius:15px;
    display:flex;
    align-items:center;
    justify-content:center;
    color:#fff;
    font-size:23px;
    background:linear-gradient(
        135deg,
        var(--primary),
        var(--primary2)
    );
    box-shadow:0 8px 22px rgba(8,127,63,.22)
}

.brand h2{
    color:var(--primary);
    font-size:16px
}

.brand p{
    color:var(--muted);
    font-size:8px;
    margin-top:4px
}

.top-actions{
    display:flex;
    align-items:center;
    gap:8px
}

.icon-btn{
    width:42px;
    height:42px;
    border:1px solid var(--border);
    background:#fff;
    border-radius:12px;
    font-size:17px;
    position:relative
}

.icon-btn:hover{
    background:#f2f8f4;
    border-color:#b8d9c5
}

.dot{
    position:absolute;
    top:7px;
    left:7px;
    width:8px;
    height:8px;
    border-radius:50%;
    background:var(--danger);
    border:2px solid white
}

.profile{
    display:flex;
    align-items:center;
    gap:9px;
    margin-right:8px;
    padding-right:13px;
    border-right:1px solid var(--border)
}

.avatar{
    width:40px;
    height:40px;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    background:#e5f5ec;
    color:var(--primary);
    font-weight:bold
}

.profile strong{
    display:block;
    font-size:10px
}

.profile small{
    color:var(--muted);
    font-size:8px
}

/* SIDEBAR */

.sidebar{
    position:fixed;
    z-index:900;
    top:74px;
    right:0;
    bottom:0;
    width:255px;
    padding:18px 12px;
    background:
        linear-gradient(
            180deg,
            var(--dark),
            #0c1b14
        );
    overflow-y:auto
}

.menu-title{
    color:#6e8177;
    font-size:8px;
    padding:9px 13px
}

.menu{
    list-style:none
}

.menu li{
    margin-bottom:4px
}

.menu a{
    min-height:45px;
    padding:0 13px;
    border-radius:11px;
    display:flex;
    align-items:center;
    gap:11px;
    color:#d9e5df;
    font-size:10px;
    transition:.2s
}

.menu a:hover{
    background:rgba(255,255,255,.07)
}

.menu a.active{
    color:#fff;
    background:
        linear-gradient(
            135deg,
            var(--primary),
            var(--primary2)
        );
    box-shadow:
        0 8px 22px rgba(0,0,0,.18)
}

.menu-icon{
    width:25px;
    text-align:center;
    font-size:16px
}

.badge{
    margin-right:auto;
    min-width:21px;
    height:21px;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    background:var(--danger);
    color:white;
    font-size:8px
}

.sidebar-bottom{
    margin-top:20px;
    padding-top:15px;
    border-top:1px solid rgba(255,255,255,.08)
}

/* MAIN */

.main{
    margin-right:255px;
    padding-top:74px;
    min-height:100vh
}

.content{
    max-width:1600px;
    margin:auto;
    padding:28px
}

.welcome{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:22px
}

.welcome h1{
    font-size:26px;
    margin-bottom:7px
}

.welcome p{
    color:var(--muted);
    font-size:10px
}

.date{
    padding:11px 15px;
    background:white;
    border:1px solid var(--border);
    border-radius:12px;
    color:var(--muted);
    font-size:9px
}

/* STATS */

.stats{
    display:grid;
    grid-template-columns:
        repeat(4,1fr);
    gap:14px;
    margin-bottom:18px
}

.stat{
    position:relative;
    overflow:hidden;
    background:var(--card);
    border:1px solid var(--border);
    border-radius:17px;
    padding:18px;
    box-shadow:var(--shadow)
}

.stat:after{
    content:"";
    position:absolute;
    width:100px;
    height:100px;
    left:-45px;
    bottom:-50px;
    border-radius:50%;
    background:#f0f8f3
}

.stat-head{
    display:flex;
    justify-content:space-between;
    align-items:center
}

.stat-icon{
    width:43px;
    height:43px;
    border-radius:13px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:20px
}

.g{
    background:#e7f7ed
}

.o{
    background:#fff3dc
}

.b{
    background:#eaf1ff
}

.r{
    background:#ffebed
}

.stat label{
    color:var(--muted);
    font-size:9px
}

.stat h2{
    font-size:24px;
    margin-top:12px
}

.change{
    margin-top:7px;
    font-size:8px;
    color:var(--success)
}

/* CARDS */

.grid{
    display:grid;
    grid-template-columns:
        minmax(0,1.7fr)
        minmax(280px,.8fr);
    gap:17px;
    margin-bottom:18px
}

.card{
    background:white;
    border:1px solid var(--border);
    border-radius:17px;
    box-shadow:var(--shadow);
    overflow:hidden
}

.card-head{
    min-height:57px;
    padding:0 18px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    border-bottom:1px solid var(--border)
}

.card-head strong{
    font-size:12px
}

.card-head a{
    color:var(--primary);
    font-size:9px
}

.card-body{
    padding:18px
}

/* SEARCH */

.search-box{
    display:flex;
    gap:8px;
    margin-bottom:15px
}

.search-box input{
    flex:1;
    height:43px;
    border:1px solid var(--border);
    border-radius:11px;
    outline:none;
    padding:0 13px;
    font-size:10px
}

.search-box input:focus{
    border-color:#91c8a7;
    box-shadow:0 0 0 3px #eaf7ef
}

.primary-btn{
    height:43px;
    border:0;
    padding:0 17px;
    border-radius:11px;
    color:#fff;
    background:
        linear-gradient(
            135deg,
            var(--primary),
            var(--primary2)
        );
    font-size:9px;
    font-weight:bold
}

/* CHART */

.chart{
    height:255px;
    display:flex;
    align-items:flex-end;
    gap:12px;
    padding:10px 5px 0
}

.bar-wrap{
    flex:1;
    height:100%;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:flex-end;
    gap:7px
}

.bar-value{
    color:#68756e;
    font-size:7px
}

.bar{
    width:100%;
    max-width:36px;
    min-height:12px;
    border-radius:8px 8px 3px 3px;
    background:
        linear-gradient(
            to top,
            var(--primary),
            var(--primary2)
        )
}

.bar-day{
    color:var(--muted);
    font-size:8px
}

/* QUICK */

.quick-grid{
    display:grid;
    grid-template-columns:
        repeat(2,1fr);
    gap:9px
}

.quick{
    border:1px solid var(--border);
    background:#fafcfb;
    border-radius:13px;
    padding:16px 8px;
    text-align:center;
    transition:.2s
}

.quick:hover{
    transform:translateY(-2px);
    border-color:#a9d5ba;
    background:#f3faf5
}

.quick b{
    display:block;
    font-size:22px;
    margin-bottom:7px
}

.quick span{
    color:#5c6862;
    font-size:8px
}

/* RESPONSIVE */

@media(max-width:1100px){

    .stats{
        grid-template-columns:
            repeat(2,1fr)
    }

    .grid{
        grid-template-columns:1fr
    }
}

@media(max-width:760px){

    .sidebar{
        right:-270px;
        transition:.25s
    }

    .sidebar.open{
        right:0
    }

    .main{
        margin-right:0
    }

    .content{
        padding:18px 11px
    }

    .profile{
        display:none
    }

    .welcome{
        align-items:flex-start
    }

    .welcome h1{
        font-size:21px
    }

    .date{
        display:none
    }

    .stats{
        gap:9px
    }

    .stat{
        padding:14px
    }

    .stat h2{
        font-size:19px
    }

    .brand p{
        display:none
    }
}

@media(max-width:430px){

    .stats{
        grid-template-columns:
            repeat(2,1fr)
    }

    .stat label{
        font-size:8px
    }
}
</style>
</head>

<body>

