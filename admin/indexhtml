<script src="assets/js/admin.js"></script>


<script>


/* =====================================================
   DASHBOARD DATA
   ===================================================== */

function loadDashboardData() {


    /*
     * في النسخة الحالية نستخدم LocalStorage
     * كطبقة مؤقتة للبيانات.
     *
     * لاحقًا سيتم ربطها بقاعدة البيانات و API.
     */


    const products =
        JSON.parse(
            localStorage.getItem(
                "albaraka_products"
            )
        ) || [];


    const orders =
        JSON.parse(
            localStorage.getItem(
                "albaraka_orders"
            )
        ) || [];


    const customers =
        JSON.parse(
            localStorage.getItem(
                "albaraka_customers"
            )
        ) || [];



    /* =================================================
       PRODUCTS
       ================================================= */

    document
        .getElementById(
            "totalProducts"
        )
        .textContent =
        products.length;



    /* =================================================
       ORDERS
       ================================================= */

    document
        .getElementById(
            "totalOrders"
        )
        .textContent =
        orders.length;



    /* =================================================
       CUSTOMERS
       ================================================= */

    document
        .getElementById(
            "totalCustomers"
        )
        .textContent =
        customers.length;



    /* =================================================
       SALES
       ================================================= */

    const totalSales =
        orders.reduce(
            function (
                total,
                order
            ) {

                return (
                    total +
                    Number(
                        order.total || 0
                    )
                );

            },
            0
        );


    document
        .getElementById(
            "totalSales"
        )
        .textContent =
        formatCurrency(
            totalSales
        );



    /* =================================================
       RECENT ORDERS
       ================================================= */

    loadRecentOrders(
        orders
    );



    /* =================================================
       LOW STOCK
       ================================================= */

    loadLowStockProducts(
        products
    );

}



/* =====================================================
   RECENT ORDERS
   ===================================================== */

function loadRecentOrders(
    orders
) {


    const container =
        document.getElementById(
            "recentOrders"
        );


    if (!container) {

        return;

    }


    if (!orders.length) {

        return;

    }


    const recent =
        [...orders]
            .sort(
                function (
                    a,
                    b
                ) {

                    return (
                        new Date(
                            b.createdAt || 0
                        ) -
                        new Date(
                            a.createdAt || 0
                        )
                    );

                }
            )
            .slice(
                0,
                5
            );


    container.innerHTML =
        recent
            .map(
                function (
                    order
                ) {

                    const status =
                        order.status ||
                        "pending";


                    return `

                        <tr>

                            <td>
                                ${
                                    escapeHTML(
                                        order.id ||
                                        "-"
                                    )
                                }
                            </td>

                            <td>
                                ${
                                    escapeHTML(
                                        order.customerName ||
                                        "عميل"
                                    )
                                }
                            </td>

                            <td>

                                <span class="price">

                                    ${
                                        formatCurrency(
                                            order.total || 0
                                        )
                                    }

                                </span>

                            </td>

                            <td>

                                <span
                                    class="status ${escapeHTML(status)}"
                                >

                                    ${
                                        getOrderStatusText(
                                            status
                                        )
                                    }

                                </span>

                            </td>

                            <td>

                                ${
                                    formatDate(
                                        order.createdAt
                                    )
                                }

                            </td>

                        </tr>

                    `;

                }
            )
            .join("");

}



/* =====================================================
   LOW STOCK PRODUCTS
   ===================================================== */

function loadLowStockProducts(
    products
) {


    const container =
        document.getElementById(
            "lowStockProducts"
        );


    if (!container) {

        return;

    }


    const lowStock =
        products
            .filter(
                function (
                    product
                ) {

                    return (
                        Number(
                            product.stock || 0
                        ) <= 5
                    );

                }
            )
            .slice(
                0,
                5
            );


    if (!lowStock.length) {

        container.innerHTML = `

            <tr>

                <td colspan="4">

                    <div class="empty-state">

                        <div class="empty-state-icon">
                            ✅
                        </div>

                        <h3>
                            المخزون جيد
                        </h3>

                        <p>
                            لا توجد منتجات منخفضة المخزون حاليًا.
                        </p>

                    </div>

                </td>

            </tr>

        `;

        return;

    }


    container.innerHTML =
        lowStock
            .map(
                function (
                    product
                ) {

                    return `

                        <tr>

                            <td>

                                <strong>
                                    ${
                                        escapeHTML(
                                            product.name ||
                                            "-"
                                        )
                                    }
                                </strong>

                            </td>

                            <td>

                                ${
                                    escapeHTML(
                                        product.category ||
                                        "-"
                                    )
                                }

                            </td>

                            <td>

                                <span class="price">

                                    ${
                                        formatCurrency(
                                            product.price || 0
                                        )
                                    }

                                </span>

                            </td>

                            <td>

                                <span
                                    class="status ${
                                        Number(
                                            product.stock || 0
                                        ) === 0
                                            ? "cancelled"
                                            : "pending"
                                    }"
                                >

                                    ${
                                        formatNumber(
                                            product.stock || 0
                                        )
                                    }

                                </span>

                            </td>

                        </tr>

                    `;

                }
            )
            .join("");

}



/* =====================================================
   INITIALIZE
   ===================================================== */

document.addEventListener(
    "DOMContentLoaded",
    function () {

        loadDashboardData();

    }
);


</script>


